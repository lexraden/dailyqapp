lX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=jdKRRqSELOAQ7kNvwGWDCFq&_nc_oc=AdpzpK1wniyYmR4cSj2zefLN_BbItTDiTzgumK8T2ZP_466vTZKwxxpZ3HClgXNnZ50&_nc_zt=23&_nc_ht=scontent-sin2-3.cdninstagram.com&_nc_gid=eXXX9_J5MXdiway0xgKjYw&_nc_ss=70689&oh=00_AQKXKOX2F7kaqstvchT_ux_vS1uC678eTAmJpYCeXK0MXg&oe=6ABD97F1", "width": 640, "height": 1136, "id": "10", "resolution": "640x1136"}], "comments": [{"author": "stafvanlierde", "author_id": "4080000250", "id": "17982272496110786", "text": "I came into this thinking he was token maxing but it was actually a well informed  explanation of something I never thought of. I was using browser use. Thanks \ud83d\ude4f\ud83c\udffb", "timestamp": 1790404013, "like_count": 0}, {"author": "zuliaun", "author_id": "11778705967", "id": "18147809542505049", "text": "Yea this is lowkey sauce, good looks bro\ud83d\udc4f\ud83c\udffc", "timestamp": 1790375705, "like_count": 0}, {"author": "fleischhauernicholas", "author_id": "61320720236", "id": "18087404306492642", "text": "yep I use this exact same trick for automations and programmatic interactions with pages i\u2019m already authenticated and signed into.", "timestamp": 1790211465, "like_count": 0}, {"author": "yahabibialby", "author_id": "1397578726", "id": "18174392026453446", "text": "Damn", "timestamp": 1790205789, "like_count": 0}, {"author": "kuna_shech", "author_id": "54000901443", "id": "18497273962097148", "text": "Ram be burning", "timestamp": 1790196785, "like_count": 0}, {"author": "shaikh_anas_025", "author_id": "5833895011", "id": "18127766101761017", "text": "Add one shared context accross all agents where they can at all times see which bugs have been reported and and which agent has picked to solve it otherwise all of them will start to solve the same bug with different solutions and waste tokens. Better approach would be to isolate finders and solvers. But this works as well.", "timestamp": 1790181816, "like_count": 0}, {"author": "hariantoatwork", "author_id": "2100490665", "id": "17893078902427464", "text": "Sounds like Cursor", "timestamp": 1790164138, "like_count": 0}, {"author": "hassaanshezad", "author_id": "27634690605", "id": "18097519445653028", "text": "Do you know any way to allow agents to test Xcode apps?", "timestamp": 1790161603, "like_count": 0}, {"author": "derick_fw", "author_id": "14661336080", "id": "18097341143644712", "text": "Until you realize starting all these git work trees and branches takes time setting up, and if you're not actively orchestrating the agents they'll stumble on other ports and collide before restarting tests on a new port from scratch. Then they shutdown the dev server as soon as they're done before reopening then again. I can't see many use cases where I would ever do this beyond just having maybe 3 ports at most. It makes it unnecessarily hard to reconcile and merge back to main when done. So much front loaded effort to manage things for no real reward compared to other methods", "timestamp": 1790158242, "like_count": 0}, {"author": "flavius.mnt", "author_id": "7232757018", "id": "18115779403962749", "text": "from my daily intensive use of ai building real products the testing part still isn\u2019t ready to be autonomously handled by ai, as they don\u2019t have a real sense of the correct uiux / logic flow of a product and in the best case would only test if things just work, not if they\u2019re pretty or optimal", "timestamp": 1790151870, "like_count": 0}, {"author": "vinci.sdesk", "author_id": "78448764234", "id": "18444634822122976", "text": "Hell yeah", "timestamp": 1790146048, "like_count": 0}, {"author": "erinem_official", "author_id": "180052535", "id": "18028386428854288", "text": "Having each agent use their own designated checkout lane for git pushes is critical; I assign each to their lane, give them a clone and make them sign with their own ssh key so I can track and verify changes. Any unsigned commit or a commit on a lane that isn\u2019t theirs is blocked, and only my yubikey and human fingerprint can unblock it. I feel like this is a better version of the same idea, because eventually it can actually funnel to your repo as a PR which you can review and merge, or whatever your sop is. \n\nBut having each agent use their own dev server feels a little pointless unless you\u2019re really iterating random versions of something. \n\nI generally try to only build something once I know what I\u2019m trying to build lol.", "timestamp": 1790142680, "like_count": 0}, {"author": "jazz.kob", "author_id": "2997602550", "id": "18136831639623291", "text": "don't build electron apps, they're the fucking worst", "timestamp": 1790137261, "like_count": 0}, {"author": "raviroyalee", "author_id": "704877217", "id": "17879898846691814", "text": "Legit \ud83d\udd25me using playwright for my enterprise application. Love it", "timestamp": 1790136468, "like_count": 0}, {"author": "_yagudaev", "author_id": "280771035", "id": "17876435697651858", "text": "Great video. I do see my agents using CDP most of the time. But I think I need to tell it explicitly.\n\nLegit great video. I\u2019ll try it on agentgrid \ud83d\ude0a", "timestamp": 1790134202, "like_count": 0}], "webpage_url": "https://www.instagram.com/reel/DdlNfHyFOGM/", "original_url": "https://www.instagram.com/reel/DdlNfHyFOGM/", "webpage_url_basename": "DdlNfHyFOGM", "webpage_url_domain": "instagram.com", "extractor": "Instagram", "extractor_key": "Instagram", "playlist": null, "playlist_index": null, "thumbnail": "https://scontent-sin2-3.cdninstagram.com/v/t51.71878-15/810931108_2166186500627259_2692824501747112340_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=107&ig_cache_key=Mzk5MTY1NTk1Nzk5ODY1NzkzMjE3OTk0ODAxMjQ5MDM5ODgx.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjY0MC5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=jdKRRqSELOAQ7kNvwGWDCFq&_nc_oc=AdpzpK1wniyYmR4cSj2zefLN_BbItTDiTzgumK8T2ZP_466vTZKwxxpZ3HClgXNnZ50&_nc_zt=23&_nc_ht=scontent-sin2-